rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isProfileOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasAll(['uid', 'nickname', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.keys().hasOnly(['uid', 'nickname', 'createdAt', 'updatedAt', 'schemaVersion'])
          && data.uid == uid
          && data.nickname is string
          && data.nickname.size() > 0
          && data.nickname.size() <= 80
          && data.createdAt is timestamp
          && data.updatedAt == request.time
          && data.schemaVersion == 1;
      }

      allow get: if isProfileOwner();
      allow create: if isProfileOwner() && validProfile()
        && request.resource.data.createdAt == request.time;
      allow update: if isProfileOwner() && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname', 'updatedAt']);
      allow list, delete: if false;
    }

    match /users/{uid}/artworks/{artworkId} {
      function isArtworkOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow get: if isArtworkOwner() && (resource == null || resource.data.ownerUid == uid);
      allow list: if isArtworkOwner() && resource.data.ownerUid == uid;
      allow write: if false;

      match /layers/{layerId} {
        allow get, list: if isArtworkOwner()
          && get(/databases/$(database)/documents/users/$(uid)/artworks/$(artworkId)).data.ownerUid == uid;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
