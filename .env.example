# .env.local 개발 설정 예시. Web App 설정은 Firebase Console에서 확인합니다.
# 서비스 계정 키, 사용자 비밀번호, Admin 토큰은 VITE_*에 넣지 않습니다.
VITE_FIREBASE_MODE=emulator
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ai-drawing-a9177
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# 기존 .env.local과 호환됩니다. 모드를 지정했다면 두 값이 일치해야 합니다.
VITE_USE_FIREBASE_EMULATORS=true

# 승인된 운영 전환 이후에만 별도의 .env.production.local로 구성합니다.
# 위 Web App 설정을 모두 운영 프로젝트 값으로 덮어쓰고 아래 항목을 확인합니다.
# VITE_FIREBASE_MODE=production
# VITE_USE_FIREBASE_EMULATORS=false
# VITE_FIREBASE_ENABLE_PRODUCTION=false
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_FUNCTIONS_REGION=
# VITE_FIREBASE_FUNCTIONS_BASE_URL=
# VITE_FIREBASE_APP_ORIGIN=
