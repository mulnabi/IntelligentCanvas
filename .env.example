# Firebase Console의 기존 웹 앱 설정을 .env.local에 입력하세요.
# 실제 개인 설정값이나 서비스 계정 비밀키를 이 파일에 넣지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=ai-drawing-a9177
VITE_FIREBASE_APP_ID=

# 이번 단계에서 사용하지 않는 서비스의 SDK 설정 항목 (선택)
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# 개발 중 반드시 true. false/누락 시 운영 연결 대신 오류로 중단합니다.
VITE_USE_FIREBASE_EMULATORS=true
