# 승인 후 실제 프로젝트의 functions/.env.<projectId>에 적용합니다.
# Firebase가 제공하는 FIREBASE_CONFIG와 K_SERVICE는 직접 넣지 않습니다.
# 서비스 계정 이메일은 공개 식별자입니다. 서비스 계정 키는 여기에 넣지 않습니다.
INTELLIGENTCANVAS_FUNCTIONS_MODE=
INTELLIGENTCANVAS_PROJECT_ID=
INTELLIGENTCANVAS_STORAGE_BUCKET=
INTELLIGENTCANVAS_FUNCTIONS_REGION=
INTELLIGENTCANVAS_WEB_ORIGIN=
INTELLIGENTCANVAS_SERVICE_ACCOUNT=
